# Sugar Configuration
# Copy this file to .env and fill in your values

# Ollama (local LLM)
OLLAMA_MODEL=mistral
OLLAMA_HOST=http://localhost:11434

# Linear (optional — leave blank to disable)
LINEAR_API_KEY=

# Obsidian vault path (set to your vault directory)
OBSIDIAN_VAULT_PATH=

# Telegram Bot (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
